{
  "name": "geo-insight",
  "private": true,
  "version": "1.0.0",
  "description": "GEO Insight —— AI 品牌可见性监测平台（React + TypeScript 前端，Express AI 接入层）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
