# ===== GEO Insight 环境变量模板 =====
# 复制为 .env 并按需填写；全部留空时系统运行于「演示回放」模式（无需任何 Key）

# --- LLM 接入（探针问题实时生成；任意 OpenAI 兼容接口）---
# DeepSeek 示例：https://api.deepseek.com/v1  模型 deepseek-chat
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# 智谱GLM示例：https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- 服务端口 ---
PORT=8787
